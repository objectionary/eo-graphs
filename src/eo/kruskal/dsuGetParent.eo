# Returns the root parent of node, or node itself when it has no parent.

+architect yegor256@gmail.com
+home https://github.com/objectionary/eo-graphs
+package kruskal
+spdx SPDX-FileCopyrightText: Copyright (c) 2020-2026 Objectionary
+spdx SPDX-License-Identifier: MIT
+version 0.0.0

[node dsu] > dsuGetParent
  getter node > @
  [^ i] > getter
    if. > @
      (parent.as-number.eq -1).not
      ^.getter parent.as-number
      i
    ^.dsu.at i > parent!

  [] +> tests-finds-root-parent
    (kruskal.dsuGetParent 2 (* -1 0 1)).eq 0 > @
